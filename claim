  <!-- ================= SCRIPT LOGIC ================= -->
  <script>
    const SCRIPT_URL = "PASTE_YOUR_APPS_SCRIPT_WEB_APP_URL_HERE";

    let currentVerifiedData = null;
    let activeTabKey = 'lic';

    const services = {
      lic: {
        badge: "LIC OF INDIA",
        title: "Life (LIC) Services & Claims",
        desc: "LIC policy maturity, money-back returns, death claim aur bond loan ki suvidha.",
        subTypes: [
          "Maturity Claim (अवधि पूर्ण)",
          "Survival Benefit (Money Back)",
          "Death Claim (मृत्यु दावा)",
          "Policy Loan / Surrender Sahayata"
        ],
        docs: [
          "Original Policy Bond",
          "Bank Passbook / Cancelled Cheque (NEFT ke liye)",
          "Policyholder ka Aadhar Card & PAN Card",
          "Death Claim me: Death Certificate & Form 3783"
        ]
      },
      csc: {
        badge: "CSC & PRIVATE LIFE",
        title: "Life (CSC / Private) Services",
        desc: "PM Jeevan Jyoti Bima Yojana, PM Suraksha Bima ya anya private life companies ke daave.",
        subTypes: [
          "PMJJBY Death Claim (₹2 Lakh)",
          "PMSBY Accidental Claim",
          "Private Life Maturity Settlement",
          "Nominee Update / KYC Change"
        ],
        docs: [
          "Bank Passbook (Jisme se premium kata tha)",
          "Aadhar Card (Bima dharak & Nominee)",
          "Claim Form & Aavedan Patra",
          "Hospital ya Death Certificate (mamle anusaar)"
        ]
      },
      motor: {
        badge: "VEHICLE INSURANCE",
        title: "Motor (Gadi) Bima Claims",
        desc: "Car, Bike, Tractor aur Commercial gadiyo ke accident, kanch tootne ya chori ke daave.",
        subTypes: [
          "Accident / Own Damage Claim",
          "Windshield / Kanch Tootna",
          "Gadi Chori (Theft Claim)",
          "Third Party Nuksan Sahayata"
        ],
        docs: [
          "R.C. Copy (Registration Certificate)",
          "Chalak ka Driving Licence (D.L.)",
          "Bima Policy Copy",
          "Accident sthal ki photo ya spot video",
          "Chori ya police case me: FIR Copy"
        ]
      },
      health: {
        badge: "MEDICLAIM & HEALTH",
        title: "Health (Swasthya) Bima Claims",
        desc: "Hospital me bharti hone par cashless ilaj aur reimbursement claim sahayata.",
        subTypes: [
          "Cashless Hospitalization Assistance",
          "Hospital Bill Reimbursement (पैसा वापस)",
          "Pre & Post Hospitalization Dawayi Bill"
        ],
        docs: [
          "Health Card / Policy Copy",
          "Hospital Discharge Summary Report",
          "Hospital ke Final Bills & Payment Receipts",
          "Doctors Prescription & Dawaiyo ke Original Parcha"
        ]
      }
    };

    function switchTab(key) {
      activeTabKey = key;
      const data = services[key];

      // Update Top Nav
      document.querySelectorAll('.nav-btn').forEach(b => {
        b.className = "nav-btn bg-white border border-slate-300 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5 hover:bg-slate-100 transition";
      });
      const currentNav = document.getElementById(`nav-${key}`);
      if(currentNav) {
        currentNav.className = "nav-btn bg-slate-900 text-white text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5 transition";
      }

      // Update Tab Cards
      document.querySelectorAll('.tab-card').forEach(c => {
        c.classList.remove('service-btn-active', 'text-white');
        c.classList.add('bg-white', 'text-slate-800');
      });
      const currentCard = document.getElementById(`tab-${key}`);
      if(currentCard) {
        currentCard.classList.add('service-btn-active');
        currentCard.classList.remove('bg-white', 'text-slate-800');
      }

      // Update Left Side Info
      document.getElementById('serviceBadge').innerText = data.badge;
      document.getElementById('serviceTitle').innerText = data.title;
      document.getElementById('serviceDesc').innerText = data.desc;

      const docsUl = document.getElementById('serviceDocs');
      docsUl.innerHTML = data.docs.map(doc => `
        <li class="flex items-start gap-2">
          <i class="fa-solid fa-file-lines text-amber-500 mt-0.5 shrink-0"></i>
          <span>${doc}</span>
        </li>
      `).join('');

      // Update Form fields
      const categoryNames = { lic: 'Life (LIC)', csc: 'Life (CSC/Other)', motor: 'Motor Insurance', health: 'Health Insurance' };
      document.getElementById('selectedServiceCategory').value = categoryNames[key];

      const select = document.getElementById('claimSubType');
      select.innerHTML = data.subTypes.map(st => `<option value="${st}">${st}</option>`).join('');
    }

    // Google Sign-In & Auth
    function parseJwt(token) {
      const base64Url = token.split('.')[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
      return JSON.parse(jsonPayload);
    }

    function handleCredentialResponse(response) {
      const userObj = parseJwt(response.credential);
      unlockPortal(userObj.name, userObj.picture);
    }

    function bypassForTesting() {
      unlockPortal("Manoher Singh", "https://api.dicebear.com/7.x/bottts/svg?seed=KDS");
    }

    function unlockPortal(name, picture) {
      document.getElementById('authGateModal').classList.add('hidden');
      const portal = document.getElementById('portalContent');
      portal.classList.remove('opacity-20', 'pointer-events-none');

      const userProfile = document.getElementById('userProfile');
      userProfile.classList.remove('hidden');
      userProfile.classList.add('flex');
      document.getElementById('userName').innerText = name;
      document.getElementById('userAvatar').src = picture;

      switchTab('lic');
    }

    function handleLogout() {
      location.reload();
    }

    // Client Sheet Verification
    async function verifyClient() {
      const key = document.getElementById('verifyInput').value.trim();
      const alertBox = document.getElementById('verifyAlert');
      const form = document.getElementById('claimActualForm');
      const btn = document.getElementById('btnVerify');

      if (!key) {
        alertBox.className = "mt-3 p-3 rounded-xl text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 block";
        alertBox.innerText = "Kripya apna Policy Number ya Mobile Number dalein!";
        return;
      }

      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Checking...`;
      alertBox.className = "hidden";

      try {
        const response = await fetch(`${SCRIPT_URL}?action=verify&key=${encodeURIComponent(key)}`);
        const result = await response.json();

        if (result.found) {
          currentVerifiedData = result.client;

          document.getElementById('custName').value = result.client.name || '-';
          document.getElementById('custPolicy').value = result.client.policyNo || '-';
          document.getElementById('custPhone').value = result.client.phone || '-';
          document.getElementById('custAddress').value = result.client.address || '-';
          document.getElementById('custProduct').value = result.client.product || '-';

          alertBox.className = "mt-3 p-3.5 rounded-xl text-xs bg-emerald-50 text-emerald-800 border border-emerald-300 block";
          alertBox.innerHTML = `<strong>Kamyab!</strong> Swagat hai, <b>${result.client.name}</b>. Niche apni claim request bharein.`;
          form.classList.remove('hidden');
        } else {
          currentVerifiedData = null;
          form.classList.add('hidden');
          alertBox.className = "mt-3 p-3.5 rounded-xl text-xs bg-rose-50 text-rose-800 border border-rose-300 block";
          alertBox.innerHTML = `<strong>Sorry!</strong> Yeh Policy / Mobile Number client sheet me nahi mila.`;
        }
      } catch (err) {
        alertBox.className = "mt-3 p-3 rounded-xl text-xs bg-rose-50 text-rose-800 border border-rose-200 block";
        alertBox.innerText = "Error: Database se sampark nahi ho saka. Apps Script URL check karein.";
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-magnifying-glass"></i> Verify`;
      }
    }

    // Form Submit to 'claim' Sheet
    async function handleClaimSubmit(e) {
      e.preventDefault();
      if (!currentVerifiedData) return;

      const submitBtn = document.getElementById('btnSubmit');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Submitting...`;

      const payload = {
        policyNo: document.getElementById('custPolicy').value,
        name: document.getElementById('custName').value,
        phone: document.getElementById('custPhone').value,
        address: document.getElementById('custAddress').value,
        product: document.getElementById('custProduct').value,
        serviceCategory: document.getElementById('selectedServiceCategory').value,
        claimSubType: document.getElementById('claimSubType').value,
        remarks: document.getElementById('claimRemarks').value
      };

      try {
        await fetch(SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        alert("Aapka claim safaltapoorvak 'claim' sheet me darj kar diya gaya hai!");
        document.getElementById('claimActualForm').reset();
        document.getElementById('claimActualForm').classList.add('hidden');
        document.getElementById('verifyInput').value = '';
        document.getElementById('verifyAlert').className = "hidden";
        currentVerifiedData = null;
      } catch (err) {
        alert("Claim darj karte waqt takneeki samasya aayi.");
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> Claim 'claim' Sheet Me Submit Karein`;
      }
    }
  </script>
</body>
</html>
